# Proveedor de LLM (OpenAI por defecto)
OPENAI_API_KEY=tu_api_key_aqui

# Configuración opcional de LangSmith (para rastreo y debugging)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=tu_langchain_api_key

# --- Headroom-AI (compresión de tokens) ---
# Activa/desactiva la compresión de contexto antes de cada llamada al LLM
HEADROOM_ENABLED=true
# Presupuesto de tokens máximo por llamada comprimida (el excedente se comprime)
HEADROOM_TOKEN_BUDGET=2000
# HEADROOM_API_KEY=           # Solo necesaria si usas el proxy cloud de Headroom (Opción B)

# --- Replicate (Generación de Imágenes) ---
REPLICATE_KEY=tu_replicate_key_aqui

GEMINI_KEY=tu_gemini_key_aqui

